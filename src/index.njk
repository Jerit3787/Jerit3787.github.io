---
layout: layouts/base.njk
title: Danish Hakim | Portfolio
---
{% from "macros/ui.njk" import heading, chips, linkBtn, infoCard %}

{# ===================== HERO ===================== #}
<section id="home" class="relative flex min-h-screen items-center overflow-hidden scroll-mt-16 pt-16">
  <div class="pointer-events-none absolute -left-32 top-10 h-96 w-96 rounded-full bg-fg/10 blur-3xl"></div>
  <div class="pointer-events-none absolute -right-24 top-1/3 h-80 w-80 rounded-full bg-fg/5 blur-3xl"></div>
  <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-5 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="max-w-2xl">
      <p class="font-mono text-sm text-fg">{{ profile.hero.greeting }}</p>
      <h1 class="mt-3 text-4xl font-bold leading-tight text-fg sm:text-6xl">
        <span class="typewrite bg-fg bg-clip-text text-transparent" data-period="2000"
          data-type='{{ profile.hero.roles | dump }}'><span class="wrap"></span></span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">{{ profile.hero.tagline }}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        {% for cta in profile.hero.ctas %}
          <a href="{{ cta.href }}"
            class="rounded-xl px-6 py-3 text-sm font-semibold transition
            {{ 'bg-fg text-surface shadow-glow hover:opacity-90' if cta.primary else 'border border-fg/15 text-muted hover:bg-fg/5' }}">
            {{ cta.label }}
          </a>
        {% endfor %}
      </div>
      <div class="mt-10 flex gap-4">
        {% for s in site.social %}
          <a href="{{ s.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ s.label }}"
            class="grid h-11 w-11 place-items-center rounded-full border border-fg/10 text-muted transition hover:-translate-y-1 hover:border-fg hover:text-fg">
            <i class="fab {{ s.icon }} text-lg"></i>
          </a>
        {% endfor %}
        <a href="mailto:{{ site.email }}" aria-label="Email"
          class="grid h-11 w-11 place-items-center rounded-full border border-fg/10 text-muted transition hover:-translate-y-1 hover:border-fg hover:text-fg">
          <i class="fas fa-envelope text-lg"></i>
        </a>
      </div>
    </div>

    {# Portrait visual — fills the right side on desktop #}
    <div class="relative hidden justify-self-center lg:block">
      <span class="absolute -inset-6 rounded-[2.5rem] bg-fg/10 blur-3xl"></span>
      <div class="relative rounded-[2.25rem] bg-gradient-to-br from-fg/30 to-fg/10 p-[3px] shadow-glow">
        <img src="{{ profile.about.image }}" alt="{{ site.name }}"
          class="h-[26rem] w-[22rem] rounded-[2.1rem] object-cover">
      </div>
      <div class="absolute -left-6 top-10 flex items-center gap-2 rounded-xl border border-fg/10 bg-card/90 px-3 py-2 shadow-card backdrop-blur">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-fg/10 text-fg"><i class="fas fa-shield-halved"></i></span>
        <span class="text-xs font-medium text-muted">CTF Player</span>
      </div>
      <div class="absolute -right-5 bottom-12 flex items-center gap-2 rounded-xl border border-fg/10 bg-card/90 px-3 py-2 shadow-card backdrop-blur">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-fg/10 text-fg"><i class="fas fa-code"></i></span>
        <span class="text-xs font-medium text-muted">Web Developer</span>
      </div>
    </div>
  </div>
</section>

{# ===================== ABOUT ===================== #}
<section id="about" class="scroll-mt-16 py-24">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[1fr_2fr]">
    <div class="reveal">
      <div class="overflow-hidden rounded-2xl border border-fg/10 shadow-card">
        <img src="{{ profile.about.image }}" alt="{{ site.name }}"
          class="zoomable w-full cursor-zoom-in object-cover">
      </div>
      <div class="mt-4">
        {% set r = profile.about.resume %}
        {% if r.available %}
          <a href="{{ r.url }}"
            class="flex items-center justify-center gap-2 rounded-xl bg-fg px-5 py-3 text-sm font-semibold text-surface shadow-glow transition hover:opacity-90">
            <i class="material-icons text-[18px]">file_download</i>{{ r.label }}
          </a>
        {% else %}
          <span title="{{ r.unavailableText }}"
            class="flex cursor-not-allowed items-center justify-center gap-2 rounded-xl bg-fg/5 px-5 py-3 text-sm font-semibold text-muted">
            <i class="material-icons text-[18px]">file_download</i>{{ r.label }}
          </span>
        {% endif %}
      </div>
    </div>
    <div class="reveal">
      <h2 class="text-3xl font-bold text-fg sm:text-4xl">About Me</h2>
      <span class="mt-4 block h-1 w-16 rounded-full bg-fg"></span>
      {% for p in profile.about.paragraphs %}
        <p class="mt-5 leading-relaxed {{ 'text-lg text-muted' if loop.first else 'text-muted' }}">{{ p | safe }}</p>
      {% endfor %}
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {% for d in profile.about.details %}
          <div class="flex items-center gap-3 rounded-xl border border-fg/10 bg-card px-4 py-3">
            <i class="material-icons text-fg">{{ d.icon }}</i>
            <span class="text-sm text-muted">{{ d.text }}</span>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# ===================== ACHIEVEMENTS (featured) ===================== #}
<section id="achievements" class="scroll-mt-16 bg-card/40 py-24">
  <div class="mx-auto max-w-6xl px-5">
    {{ heading("Latest Achievements", achievements.homeIntro) }}
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for section in achievements.sections %}
        {% for item in section.items %}
          {% if item.featured %}{{ infoCard(item) }}{% endif %}
        {% endfor %}
      {% endfor %}
    </div>
    <div class="mt-10 text-center reveal">
      <a href="/achievements/"
        class="inline-flex items-center gap-2 rounded-xl bg-fg px-6 py-3 text-sm font-semibold text-surface shadow-glow transition hover:opacity-90">
        <i class="material-icons text-[18px]">emoji_events</i>View All Achievements
      </a>
    </div>
  </div>
</section>

{# ===================== CTF WRITEUPS ===================== #}
<section id="ctf-writeups" class="scroll-mt-16 py-24">
  <div class="mx-auto max-w-6xl px-5">
    {{ heading("CTF Writeups", ctf.intro) }}
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% for item in ctf.items %}{{ infoCard(item) }}{% endfor %}
    </div>
    <div class="mt-10 text-center reveal">
      <a href="{{ ctf.viewAllUrl }}"
        class="inline-flex items-center gap-2 rounded-xl border border-fg/15 px-6 py-3 text-sm font-semibold text-muted transition hover:bg-fg/5">
        <i class="material-icons text-[18px]">list</i>View All CTF Writeups
      </a>
    </div>
  </div>
</section>

{# ===================== SKILLS ===================== #}
<section id="skills" class="scroll-mt-16 bg-card/40 py-24">
  <div class="mx-auto max-w-6xl px-5">
    {{ heading("Skills &amp; Expertise", skills.intro) }}
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {% for group in skills.groups %}
        <div class="reveal rounded-2xl border border-fg/10 bg-card p-6 transition hover:-translate-y-1 hover:border-fg/30">
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-fg/10 text-fg">
              <i class="fas {{ group.icon }} text-lg"></i>
            </span>
            <h3 class="font-semibold text-fg">{{ group.title }}</h3>
          </div>
          <div class="mt-5 space-y-4">
            {% for item in group.items %}
              <div>
                <div class="flex items-center justify-between text-sm">
                  <span class="text-muted">{{ item.name }}</span>
                  <span class="text-muted">{{ item.level }}%</span>
                </div>
                <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-fg/5">
                  <div class="skill-bar h-full rounded-full bg-fg" style="width: {{ item.level }}%"></div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{# ===================== EXPERIENCE ===================== #}
<section id="experience" class="scroll-mt-16 py-24">
  <div class="mx-auto max-w-6xl px-5">
    {{ heading("Experience &amp; Activities", experience.intro) }}
    {% for category in experience.categories %}
      <div class="mt-12">
        <h3 class="reveal mb-6 flex items-center gap-3 text-xl font-semibold text-fg">
          <span class="h-5 w-1 rounded-full bg-fg"></span>{{ category.name }}
        </h3>
        <div class="grid gap-6 md:grid-cols-2">
          {% for item in category.items %}{{ infoCard(item) }}{% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{# ===================== PROJECTS ===================== #}
<section id="projects" class="scroll-mt-16 bg-card/40 py-24">
  <div class="mx-auto max-w-6xl px-5">
    {{ heading("My Projects", projects.intro) }}
    {% for category in projects.categories %}
      <div class="mt-12">
        <h3 class="reveal mb-6 flex items-center gap-3 text-xl font-semibold text-fg">
          <span class="h-5 w-1 rounded-full bg-fg"></span>{{ category.name }}
        </h3>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {% for item in category.items %}{{ infoCard(item) }}{% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{# ===================== CONTACT ===================== #}
<section id="contact" class="scroll-mt-16 py-24">
  <div class="mx-auto max-w-6xl px-5">
    {{ heading("Contact Me", "Let's connect and discuss how we can work together") }}
    <div class="reveal mx-auto mt-12 max-w-2xl rounded-2xl border border-fg/10 bg-card p-8 text-center shadow-card sm:p-12">
      <span class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-fg/10 text-fg">
        <i class="material-icons text-3xl">email</i>
      </span>
      <h3 class="mt-5 text-2xl font-semibold text-fg">Get In Touch</h3>
      <p class="mt-3 text-muted">Feel free to reach out for collaborations, project inquiries, or just to say hello!</p>
      <a href="mailto:{{ site.email }}"
        class="mt-6 inline-flex items-center gap-2 rounded-xl bg-fg px-7 py-3.5 text-sm font-semibold text-surface shadow-glow transition hover:opacity-90">
        <i class="material-icons text-[18px]">send</i>Send Me an Email
      </a>
      <div class="mt-6 flex items-center justify-center gap-2 text-sm text-muted">
        <i class="material-icons text-fg text-[18px]">location_on</i><span>Malaysia</span>
      </div>
      <div class="mt-6 flex justify-center gap-3">
        {% for s in site.social %}
          <a href="{{ s.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ s.label }}"
            class="grid h-11 w-11 place-items-center rounded-full border border-fg/10 text-muted transition hover:-translate-y-1 hover:border-fg hover:text-fg">
            <i class="fab {{ s.icon }}"></i>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
