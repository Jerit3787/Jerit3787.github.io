{# ----- Section heading ----- #}
{% macro heading(title, intro) %}
  <div class="mx-auto max-w-2xl text-center reveal">
    <h2 class="text-3xl font-bold text-fg sm:text-4xl">{{ title | safe }}</h2>
    <span class="mx-auto mt-4 block h-1 w-16 rounded-full bg-fg"></span>
    {% if intro %}<p class="mt-4 text-muted">{{ intro }}</p>{% endif %}
  </div>
{% endmacro %}

{# ----- Chip list ----- #}
{% macro chips(list) %}
  {% if list and list.length %}
    <div class="mt-4 flex flex-wrap gap-2">
      {% for c in list %}
        <span class="rounded-full border border-fg/20 bg-fg/10 px-2.5 py-1 text-xs font-medium text-muted">{{ c }}</span>
      {% endfor %}
    </div>
  {% endif %}
{% endmacro %}

{# ----- Button (link) ----- #}
{% macro linkBtn(link) %}
  {% if link.disabled %}
    <span title="{{ link.unavailableText }}" class="btn-disabled">{{ link.label }}</span>
  {% else %}
    <a href="{{ link.href }}" target="_blank" rel="noopener noreferrer" class="btn-soft">{{ link.label }}</a>
  {% endif %}
{% endmacro %}

{# ----- Placement award stamp (monochrome, theme-aware) ----- #}
{% macro rankStamp(rank) %}
  <div class="pointer-events-none absolute right-3 top-3 z-10 text-fg drop-shadow-[0_2px_6px_rgba(0,0,0,0.55)]">
    <svg viewBox="0 0 84 108" class="h-[4.75rem] w-auto" aria-hidden="true">
      <!-- ribbon tails -->
      <path d="M30 64 L21 104 L34 94 L42 106 L50 94 L63 104 L54 64 Z" fill="currentColor"/>
      <!-- scalloped seal edge -->
      <circle cx="42" cy="40" r="34" fill="currentColor" stroke="currentColor" stroke-width="4"
        stroke-dasharray="2.2 3.4" stroke-linecap="round"/>
      <circle cx="42" cy="40" r="31" fill="currentColor"/>
      <circle cx="42" cy="40" r="26" fill="none" stroke="rgb(var(--surface))" stroke-width="1.4"/>
      <text x="42" y="45" text-anchor="middle" fill="rgb(var(--surface))" font-family="Poppins, sans-serif"
        font-weight="800" font-size="24">{{ rank.num }}<tspan font-size="12" dy="-9" font-weight="700">{{ rank.ord }}</tspan></text>
      <text x="42" y="57" text-anchor="middle" fill="rgb(var(--surface))" font-family="Poppins, sans-serif"
        font-size="7.5" font-weight="700" letter-spacing="1.6">PLACE</text>
    </svg>
  </div>
{% endmacro %}

{# ----- Card media: image or icon placeholder ----- #}
{% macro media(item) %}
  <div class="relative h-44 overflow-hidden">
    {% if item.rank %}{{ rankStamp(item.rank) }}{% endif %}
    {% if item.image %}
      <img src="{{ item.image }}" alt="{{ item.alt or item.title }}"
        class="zoomable h-full w-full cursor-zoom-in object-cover transition duration-500 group-hover:scale-105">
    {% else %}
      <div class="grid h-full w-full place-items-center bg-gradient-to-br from-elevated to-card">
        <i class="fas {{ item.icon or 'fa-trophy' }} text-5xl text-fg/70"></i>
      </div>
    {% endif %}
  </div>
{% endmacro %}

{# ----- Achievement / experience-style card (with optional bullets) ----- #}
{% macro infoCard(item) %}
  <article class="reveal group flex flex-col overflow-hidden rounded-2xl border border-fg/10 bg-card shadow-card transition duration-300 hover:-translate-y-1 hover:border-fg/30">
    {{ media(item) }}
    <div class="flex flex-1 flex-col p-6">
      <h3 class="text-lg font-semibold text-fg">{{ item.title }}</h3>
      <p class="mt-1 text-sm font-medium text-fg">{{ item.date or item.subtitle }}</p>
      <span class="my-3 block h-px w-12 bg-fg/10"></span>
      <p class="text-sm leading-relaxed text-muted">{{ item.description }}</p>
      {% if item.bullets and item.bullets.length %}
        <ul class="mt-3 space-y-1.5 text-sm text-muted">
          {% for b in item.bullets %}
            <li class="flex gap-2"><i class="fas fa-angle-right mt-1 text-xs text-fg"></i><span>{{ b }}</span></li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if item.links and item.links.length %}
        <div class="mt-4 flex flex-wrap gap-2">
          {% for l in item.links %}{{ linkBtn(l) }}{% endfor %}
        </div>
      {% elif item.link %}
        <div class="mt-4">{{ linkBtn(item.link) }}</div>
      {% endif %}
      {{ chips(item.chips) }}
    </div>
  </article>
{% endmacro %}
