<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<!-- Mark that JS is active so scroll-reveal only hides content when it can be revealed. -->
<script>document.documentElement.classList.add("js");</script>

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ site.meta.description }}">
  <meta name="keywords" content="{{ site.meta.keywords }}">
  <meta name="author" content="{{ site.meta.author }}">

  <!-- Open Graph / Social Media Meta Tags -->
  <meta property="og:title" content="{{ site.meta.ogTitle }}">
  <meta property="og:description" content="{{ site.meta.ogDescription }}">
  <meta property="og:image" content="{{ site.meta.ogImage }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}">
  <meta property="og:site_name" content="Danish Hakim Portfolio">

  <!-- Twitter Card data -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="{{ site.meta.twitterHandle }}">
  <meta name="twitter:title" content="{{ site.meta.ogTitle }}">
  <meta name="twitter:description" content="{{ site.meta.ogDescription }}">
  <meta name="twitter:image" content="{{ site.meta.ogImage }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anonymous+Pro:wght@400;700&family=Poppins:wght@300;400;500;600;700&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
  <script defer src="/assets/js/main.js"></script>
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "fc5e9ebac04f41f4989292b139942e6f"}'></script>
  <title>{{ title or site.title }}</title>
</head>

<body class="bg-surface text-muted font-sans antialiased selection:bg-fg/20">
  {% set rootRelative = rootRelative or false %}

  <!-- Top navigation -->
  <header id="site-header"
    class="fixed inset-x-0 top-0 z-50 border-b border-fg/10 bg-surface/70 backdrop-blur-md transition-shadow">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
      <a href="{{ '/' if rootRelative else '#home' }}" class="flex items-center gap-3">
        <img src="{{ site.logo }}" alt="{{ site.name }}"
          class="h-10 w-10 rounded-full border border-fg/30 p-0.5">
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {% for link in site.nav %}
          {% set href = link.href %}
          {% if rootRelative %}{% set href = ('/' if link.href == '#home' else '/' + link.href) %}{% endif %}
          <li>
            <a href="{{ href }}"
              class="nav-link rounded-lg px-3 py-2 text-sm font-medium text-muted transition hover:bg-fg/5 hover:text-fg">
              {{ link.label }}
            </a>
          </li>
        {% endfor %}
        <li>
          <button id="theme-toggle" type="button" aria-label="Toggle theme"
            class="ml-2 grid h-9 w-9 place-items-center rounded-full bg-fg/5 text-fg transition hover:bg-fg/10">
            <i class="material-icons text-[20px]">brightness_4</i>
          </button>
        </li>
      </ul>

      <button id="nav-toggle" type="button" aria-label="Open menu"
        class="grid h-10 w-10 place-items-center rounded-lg bg-fg/5 text-fg lg:hidden">
        <i class="material-icons">menu</i>
      </button>
    </nav>
  </header>

  <!-- Mobile drawer -->
  <div id="nav-overlay" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm lg:hidden"></div>
  <aside id="mobile-nav"
    class="fixed right-0 top-0 z-[60] flex h-full w-72 translate-x-full flex-col bg-card shadow-2xl transition-transform duration-300 lg:hidden">
    <div class="relative border-b border-fg/10 bg-elevated px-5 pb-6 pt-8">
      <button id="nav-close" type="button" aria-label="Close menu"
        class="absolute right-4 top-4 text-muted hover:text-fg">
        <i class="material-icons">close</i>
      </button>
      <img src="{{ site.profileImage }}" alt="{{ site.name }}"
        class="h-16 w-16 rounded-full border-2 border-fg/30 object-cover">
      <p class="mt-3 font-semibold text-fg">{{ site.name }}</p>
      <p class="text-sm text-muted">{{ site.email }}</p>
    </div>
    <ul class="flex flex-1 flex-col gap-1 overflow-y-auto px-3 py-4">
      {% for link in site.nav %}
        {% set href = link.href %}
        {% if rootRelative %}{% set href = ('/' if link.href == '#home' else '/' + link.href) %}{% endif %}
        <li>
          <a href="{{ href }}"
            class="mobile-link flex items-center gap-3 rounded-lg px-3 py-2.5 text-muted transition hover:bg-fg/5 hover:text-fg">
            <i class="material-icons text-fg">{{ link.icon }}</i>{{ link.label }}
          </a>
        </li>
      {% endfor %}
      <li class="my-2 border-t border-fg/10"></li>
      <li>
        <button id="mobile-theme-toggle" type="button"
          class="mobile-link flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-muted transition hover:bg-fg/5 hover:text-fg">
          <i class="material-icons text-fg">settings</i>Toggle Theme
        </button>
      </li>
    </ul>
    <div class="flex gap-3 border-t border-fg/10 px-5 py-4">
      {% for s in site.social %}
        <a href="{{ s.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ s.label }}"
          class="grid h-9 w-9 place-items-center rounded-full bg-fg/5 text-muted transition hover:bg-fg hover:text-surface">
          <i class="fab {{ s.icon }}"></i>
        </a>
      {% endfor %}
    </div>
  </aside>

  <main>
    {{ content | safe }}
  </main>

  <!-- Footer -->
  <footer class="border-t border-fg/10 bg-card/60">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <h5 class="text-lg font-semibold text-fg">{{ site.name }}</h5>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">{{ site.footer.blurb }}</p>
        <div class="mt-4 flex gap-3">
          {% for s in site.social %}
            <a href="{{ s.href }}" target="_blank" rel="noopener noreferrer" aria-label="{{ s.label }}"
              class="grid h-9 w-9 place-items-center rounded-full bg-fg/5 text-muted transition hover:bg-fg hover:text-surface">
              <i class="fab {{ s.icon }}"></i>
            </a>
          {% endfor %}
          <a href="mailto:{{ site.email }}" aria-label="Email"
            class="grid h-9 w-9 place-items-center rounded-full bg-fg/5 text-muted transition hover:bg-fg hover:text-surface">
            <i class="fas fa-envelope"></i>
          </a>
        </div>
      </div>
      {% for col in site.footer.columns %}
        <div>
          <h5 class="text-sm font-semibold uppercase tracking-wide text-fg">{{ col.heading }}</h5>
          <ul class="mt-3 space-y-2 text-sm">
            {% for l in col.links %}
              <li>
                <a href="{{ l.href }}" class="inline-flex items-center gap-2 text-muted transition hover:text-fg">
                  <i class="{{ l.icon }} w-4 text-center"></i>{{ l.label }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
    <div class="border-t border-fg/10">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-4 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
        <span>&copy; {{ site.footer.copyrightStart }}-{{ currentYear }} {{ site.name }} | All Rights Reserved</span>
        <span class="inline-flex items-center gap-2.5">
          <span>Built with</span>
          <a href="https://www.11ty.dev/" target="_blank" rel="noopener noreferrer" aria-label="Eleventy"
            class="text-muted transition hover:text-fg">
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true"><path d="M3.398 12V0h17.204v24H3.398zm13.17 6.07a1.07 1.07 0 00.373-.107c.432-.213.68-.672.877-1.626.076-.372 1.195-6.168 1.209-6.263.026-.186-.008-.382-.084-.476a.325.325 0 00-.087-.064l-.06-.031h-.291c-.253 0-.298 0-.348.02-.113.039-.207.156-.255.316-.011.038-.168.881-.348 1.873l-.328 1.802-.046-.21c-.56-2.547-.764-3.452-.794-3.532a.383.383 0 00-.103-.16c-.105-.107-.117-.11-.567-.11-.411 0-.422 0-.5.074-.086.079-.122.216-.111.42.006.115.045.27.688 2.784.663 2.587.751 2.943.787 3.177.046.3-.05.713-.208.893-.032.037-.037.039-.084.032-.028 0-.12-.027-.204-.051-.268-.078-.362-.072-.462.028-.096.096-.137.248-.138.51 0 .256.028.34.159.473.131.133.324.208.595.23.164.012.22.012.33-.001zm-1.896-1.712a.31.31 0 00.16-.192c.02-.058.022-.098.022-.356 0-.255-.003-.299-.021-.354-.04-.121-.136-.196-.278-.217-.041-.01-.2-.01-.355-.01-.365-.001-.378-.01-.446-.184-.068-.18-.096-.326-.113-.602a85.799 85.799 0 01-.012-1.94v-1.765h.35c.454 0 .507-.01.602-.113a.465.465 0 00.102-.24 3.273 3.273 0 000-.534c-.026-.16-.099-.271-.211-.322-.057-.025-.065-.026-.45-.03h-.392l-.003-1.22c-.003-1.09-.005-1.227-.021-1.278a.378.378 0 00-.201-.247c-.052-.024-.072-.025-.32-.029-.27 0-.356 0-.429.038-.087.042-.148.133-.185.278-.014.054-.032.346-.076 1.262l-.06 1.194s-.08 0-.18.01c-.206.01-.263.022-.327.086-.092.092-.12.19-.127.455-.01.334.02.487.115.588.075.081.134.1.345.106l.173.01v1.785c0 1.7.006 2.019.034 2.274.041.37.13.709.241.928.194.38.544.617.988.668h1.005l.07-.04zm-7.447 0c.098-.053.16-.154.2-.332.016-.077.018-.401.018-4.518 0-4.184-.001-4.44-.02-4.51-.05-.194-.19-.29-.378-.26-.035.01-.344.084-.686.175-.343.09-.684.18-.758.198-.17.043-.214.062-.281.126-.105.098-.122.185-.122.606 0 .416.016.5.12.604.094.095.189.1.456.03.103-.026.193-.048.2-.048.01 0 .014.784.017 3.763.003 3.436.005 3.77.021 3.84.048.202.113.296.236.34.034.013.133.016.487.014.435 0 .445 0 .49-.027zm3.203 0c.092-.046.152-.135.197-.29l.024-.084.00